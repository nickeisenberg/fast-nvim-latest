# vendored Neovim builds (created by scripts/fetch_nvim.py)
src/fast_nvim_latest/_nvim/*
!src/fast_nvim_latest/_nvim/.gitkeep
# Neovim's license travels with every wheel, so it is tracked in git
!src/fast_nvim_latest/_nvim/LICENSE.nvim.txt

# build artifacts
build/
dist/
wheelhouse/
*.egg-info/
src/*.egg-info/
.eggs/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# keep the package marker so the tree exists before vendoring
!src/fast_nvim_latest/_nvim/.gitkeep
